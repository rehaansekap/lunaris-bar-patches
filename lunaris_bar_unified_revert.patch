-    when (settings.expandedShape) {
-        0 -> RoundedCornerShape(48.dp)
-        1 -> RoundedCornerShape(settings.cornerRadius.dp)
-        else -> LunarisBarSquircle(settings.cornerRadius.dp)
-    }
