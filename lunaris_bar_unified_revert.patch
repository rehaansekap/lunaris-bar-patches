-            InputManager.INJECT_INPUT_EVENT_MODE_ASYNC,
-        )
-        input.injectInputEvent(
-            KeyEvent(now, now, KeyEvent.ACTION_UP, code, 0),
-            InputManager.INJECT_INPUT_EVENT_MODE_ASYNC,
-        )
-    }
