-internal class PopupBlurHost(context: Context) : View(context) {
-    private var blurDrawable: BackgroundBlurDrawable? = null
-    private val bounds = RectF()
-    private val fallbackPaint = Paint(Paint.ANTI_ALIAS_FLAG)
-    private var shape: Shape? = null
-    private var shapeDensity = Density(context.resources.displayMetrics.density)
-    private var shapeLayoutDirection = LayoutDirection.Ltr
-    private var clipPath: AndroidPath? = null
-    private var cornerRadiusPx = 0f
-    private var overlayColor = 0
-    private var surfaceAlpha = 255
-    private var isBlurEnabled = true
-
-    fun updateAppearance(
-        shape: Shape,
-        density: Density,
-        layoutDirection: LayoutDirection,
-        overlayColor: Int,
-        fallbackColor: Int,
-        alpha: Float,
-        enabled: Boolean,
-    ) {
-        if (
-            this.shape != shape ||
-                shapeDensity != density ||
-                shapeLayoutDirection != layoutDirection
-        ) {
-            this.shape = shape
-            shapeDensity = density
-            shapeLayoutDirection = layoutDirection
-            clipPath = null
-        }
-        this.overlayColor = overlayColor
-        this.isBlurEnabled = enabled
-        fallbackPaint.color = fallbackColor
-        surfaceAlpha = (alpha.coerceIn(0f, 1f) * 255).roundToInt()
-        updateBlurDrawable()
-        invalidate()
-    }
-
-    private fun updateBlurDrawable() {
-        if (!isAttachedToWindow) return
-        if (isBlurEnabled && surfaceAlpha > 0) {
-            if (blurDrawable == null) {
-                blurDrawable = viewRootImpl?.createBackgroundBlurDrawable()
-            }
-            blurDrawable?.apply {
-                setBlurRadius(Math.round(25 * shapeDensity.density))
-                setCornerRadius(cornerRadiusPx)
-                setColor(overlayColor)
-                setAlpha(surfaceAlpha)
-                setBounds(0, 0, width, height)
-                setVisible(true, false)
-            }
-        } else {
-            blurDrawable?.setVisible(false, false)
-        }
-    }
-
-    override fun onSizeChanged(w: Int, h: Int, oldw: Int, oldh: Int) {
-        super.onSizeChanged(w, h, oldw, oldh)
-        bounds.set(0f, 0f, w.toFloat(), h.toFloat())
-        clipPath = null
-        blurDrawable?.setBounds(0, 0, w, h)
-        updateBlurDrawable()
-    }
-
-    override fun onAttachedToWindow() {
-        super.onAttachedToWindow()
-        (parent as? ViewGroup)?.layoutTransition = null
-        updateBlurDrawable()
-    }
-
-    override fun onDetachedFromWindow() {
-        blurDrawable?.setVisible(false, false)
-        blurDrawable = null
-        super.onDetachedFromWindow()
-    }
-
-    override fun onVisibilityAggregated(isVisible: Boolean) {
-        super.onVisibilityAggregated(isVisible)
-        blurDrawable?.setVisible(isVisible, false)
-    }
-
-    override fun verifyDrawable(who: Drawable): Boolean =
-        (blurDrawable != null && who == blurDrawable) || super.verifyDrawable(who)
-
-    override fun draw(canvas: Canvas) {
-        if (width <= 0 || height <= 0 || surfaceAlpha == 0) return
-        val currentShape = shape ?: return
-        val path =
-            clipPath
-                ?: run {
-                    val outline =
-                        currentShape.createOutline(
-                            Size(width.toFloat(), height.toFloat()),
-                            shapeLayoutDirection,
-                            shapeDensity,
-                        )
-                    cornerRadiusPx =
-                        when (outline) {
-                            is Outline.Rounded -> outline.roundRect.topLeftCornerRadius.x
-                            is Outline.Generic ->
-                                if (currentShape is LunarisBarSquircle)
-                                    minOf(
-                                        with(shapeDensity) { currentShape.radius.toPx() },
-                                        width / 2f,
-                                        height / 2f,
-                                    )
-                                else 0f
-                            is Outline.Rectangle -> 0f
-                        }
-                    Path()
-                        .apply {
-                            when (outline) {
-                                is Outline.Generic -> addPath(outline.path)
-                                is Outline.Rounded -> addRoundRect(outline.roundRect)
-                                is Outline.Rectangle -> addRect(outline.rect)
-                            }
-                        }
-                        .asAndroidPath()
-                        .also { clipPath = it }
-                }
-        if (isBlurEnabled && blurDrawable != null && blurDrawable?.isVisible == true) {
-            canvas.save()
-            canvas.clipPath(path)
-            blurDrawable?.draw(canvas)
-            canvas.restore()
-        } else {
-            canvas.drawPath(path, fallbackPaint)
-        }
-    }
-}
