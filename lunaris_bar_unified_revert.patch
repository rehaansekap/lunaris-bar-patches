-            targetValue = 1.08f,
-            animationSpec =
-                infiniteRepeatable(tween(1000, easing = FastOutSlowInEasing), RepeatMode.Reverse),
-            label = "breathe",
-        )
-    val recScale by
-        transition.animateFloat(
-            initialValue = 0.9f,
-            targetValue = 1.12f,
-            animationSpec =
