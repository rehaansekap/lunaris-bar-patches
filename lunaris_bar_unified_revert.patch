-    private fun extractChronometerBase(sbn: StatusBarNotification): Long {
-        val notification = sbn.notification
-        val packageContext = runCatching {
-            context.createPackageContext(sbn.packageName, Context.CONTEXT_RESTRICTED)
-        }.getOrDefault(context)
-        sequenceOf(notification.bigContentView, notification.contentView, notification.headsUpContentView)
-            .filterNotNull().forEach { remoteViews ->
-                val base = runCatching {
-                    findChronometer(remoteViews.apply(packageContext, FrameLayout(packageContext)))?.base
-                }.getOrNull()
-                if (base != null) return base
-            }
-        if (notification.extras.getBoolean(Notification.EXTRA_SHOW_CHRONOMETER) && notification.`when` > 0L) {
-            return SystemClock.elapsedRealtime() + notification.`when` - System.currentTimeMillis()
-        }
-        return 0L
-    }
