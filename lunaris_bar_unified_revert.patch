-                if (model != null && lyricsEnabled) {
-                    val song = model.songName?.toString()
-                    val artist = model.artistName?.toString()
-                    if (song != null && artist != null) {
-                        if (song != lastFetchedSong || artist != lastFetchedArtist) {
