-        is PopupContentModel.Media ->
-            Triple(chipId, content.model.songName?.toString(), content.model.artistName?.toString())
-        is PopupContentModel.SystemEvent -> Triple(chipId, content.kind, content.title)
-        else -> chipId
-    }
