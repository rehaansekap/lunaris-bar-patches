-    private fun liveness(now: Long): Float {
-        val start = if (playing) liveStart else pauseStart + 700L
-        val t = ease(((now - start) / 600f).coerceIn(0f, 1f))
-        return liveFrom + ((if (playing) 1f else 0f) - liveFrom) * t
-    }
