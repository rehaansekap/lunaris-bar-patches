-                infiniteRepeatable(tween(4000, easing = LinearEasing), RepeatMode.Restart),
-            label = "spin",
-        )
-
-    Box(
-        modifier =
-            modifier.size(badgeSize).clip(CircleShape).background(IslandAccents.badgeFill(accent)),
-        contentAlignment = Alignment.Center,
-    ) {
-        Icon(
-            icon = icon,
